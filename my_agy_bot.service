[Unit]
Description=MY AGY AI - 24/7 Telegram Cloud Bot Supervisor
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=forking
User=root
WorkingDirectory=/root/projects/AAA_AUTO
ExecStart=/root/projects/AAA_AUTO/start_userbot.sh
ExecStop=/root/projects/AAA_AUTO/stop_userbot.sh
Restart=always
RestartSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
